{
  "name": "portfolio-larcher",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build-storybook -- -o public/storybook --quiet && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.{css,astro,svelte}\"",
    "lint:tokens": "node scripts/checks/lint-tokens.mjs",
    "lint:themes": "node scripts/checks/lint-themes.mjs",
    "lint:arch": "node scripts/checks/lint-arch.mjs",
    "lint:security": "node scripts/checks/lint-security.mjs",
    "typecheck:svelte": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint:dead": "knip",
    "check": "astro check && npm run typecheck:svelte && npm run lint && npm run lint:css && npm run lint:tokens && npm run lint:themes && npm run lint:arch && npm run lint:security && npm run lint:dead && npm run format:check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "media": "node scripts/prepare-media.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.4",
    "gsap": "^3.15.0",
    "svelte": "^5.57.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-svelte-csf": "^5.1.6",
    "@storybook/svelte": "^10.6.6",
    "@storybook/svelte-vite": "^10.6.6",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-svelte": "^3.24.0",
    "globals": "^17.14.0",
    "knip": "^6.44.1",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "storybook": "^10.6.3",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "svelte-check": "^4.7.8",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2"
  }
}
