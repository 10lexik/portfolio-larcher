{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*"],
  "exclude": ["dist", "sanity"],
  "compilerOptions": {
    "paths": {
      "@core/*": ["./src/core/*"],
      "@ui/*": ["./src/ui/*"],
      "@blocks/*": ["./src/blocks/*"],
      "@domains/*": ["./src/domains/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@data/*": ["./src/data/*"]
    }
  }
}
