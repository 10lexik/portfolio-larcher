---
import type { Locale } from '@core/content/types';
import { getNav, getSite } from '@core/content/site';
import { getAlternatePath, t } from '@core/i18n/t';

interface Props {
  locale?: Locale;
}

const { locale = 'fr' } = Astro.props;
const site = getSite(locale);
const nav = getNav(locale);
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const frHref = getAlternatePath(Astro.url.pathname, 'fr');
const enHref = getAlternatePath(Astro.url.pathname, 'en');
---

<header class="site-header" data-theme="dark">
  <div class="site-header__bar">
    <a
      class="site-header__brand"
      href={site.homeHref}
      aria-label={`${site.name} — ${t('homeAriaLabel', locale)}`}
    >
      <span class="site-header__mark" aria-hidden="true">
        {site.monogram}
      </span>
      <span class="site-header__name">{site.name}</span>
    </a>

    <nav class="site-header__nav" aria-label={t('navLabel', locale)}>
      <ul class="site-header__list">
        {nav.map((item) => (
          <li>
            <a
              class="site-header__link"
              href={item.href}
              data-astro-reload={item.reload ? '' : undefined}
              aria-current={current === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <div class="site-header__lang" role="group" aria-label={t('langSwitchLabel', locale)}>
        <a
          class="site-header__lang-link"
          href={frHref}
          hreflang="fr"
          aria-current={locale === 'fr' ? 'true' : undefined}
        >
          {t('langFr', locale)}
        </a>
        <a
          class="site-header__lang-link"
          href={enHref}
          hreflang="en"
          aria-current={locale === 'en' ? 'true' : undefined}
        >
          {t('langEn', locale)}
        </a>
      </div>

      <a
        class="site-header__cta"
        href={site.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        data-vector-btn
      >
        <span data-vector-btn-label>{t('headerCta', locale)}</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: var(--border-edge-thin);
    background-color: var(--color-dark-80);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .site-header__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    max-width: calc(var(--container-wide) + 2 * var(--spacing-fluid-x));
    margin-inline: auto;
    padding: 0.75rem var(--spacing-fluid-x);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
    color: var(--color-white);
  }

  .site-header__mark {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.7rem;
    background-image: linear-gradient(
      135deg,
      var(--color-brand-primary),
      var(--color-brand-violet)
    );
    font-size: var(--text-fluid-sm);
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--color-white);
  }

  .site-header__name {
    display: none;
    font-size: var(--text-fluid-base);

    @media (min-width: 640px) {
      display: inline;
    }
  }

  .site-header__nav {
    order: 3;
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none;

    @media (min-width: 900px) {
      order: 0;
      width: auto;
    }
  }

  .site-header__list {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    white-space: nowrap;
  }

  .site-header__link {
    display: inline-block;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-chip);
    font-size: var(--text-fluid-sm);
    font-weight: 600;
    color: var(--color-text-body);
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);

    &:hover {
      background-color: var(--color-white-10);
      color: var(--color-white);
    }

    &[aria-current='page'] {
      background-color: var(--color-primary-15);
      color: var(--color-brand-primary-light);
    }
  }

  .site-header__actions {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .site-header__lang {
    display: inline-flex;
    align-items: center;
    padding: 0.16rem;
    border: var(--border-edge-thin);
    border-radius: var(--radius-chip);
    background-color: var(--color-white-05);
  }

  .site-header__lang-link {
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-chip);
    font-family: var(--font-mono);
    font-size: var(--text-fluid-xs);
    font-weight: 700;
    color: var(--color-text-muted);
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);

    &:hover {
      color: var(--color-white);
    }

    &[aria-current='true'] {
      background-color: var(--color-primary-15);
      color: var(--color-brand-primary-light);
    }
  }

  .site-header__cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1.1rem;
    border: var(--border-edge-md);
    border-radius: var(--radius-chip);
    font-size: var(--text-fluid-sm);
    font-weight: 700;
    color: var(--color-white);
    transition: background-color var(--duration-fast) var(--ease-standard);

    &:hover {
      background-color: var(--color-white-10);
    }

    &:has(.vector-border-svg) {
      border-color: transparent;
    }
  }
</style>
