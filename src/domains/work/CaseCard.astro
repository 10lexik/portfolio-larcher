---
import { formatTitleTypography } from '@core/utils/text';

interface Props {
  eyebrow: string;
  title: string;
  text: string;
  href: string;
  cta: string;
  /** Visuel de la carte (chemin public) */
  image?: string;
  imageAlt?: string;
  /** Carte mise en avant (mise en page large avec visuel) */
  featured?: boolean;
  chips?: string[];
}

const {
  eyebrow,
  title,
  text,
  href,
  cta,
  image,
  imageAlt = '',
  featured = false,
  chips = [],
} = Astro.props;
const formattedTitle = formatTitleTypography(title);
---

<article class:list={['case-card', featured && 'case-card--featured']} data-reveal>
  <div class="case-card__body">
    <p class="eyebrow">{eyebrow}</p>
    <h3 class="case-card__title">{formattedTitle}</h3>
    <p class="case-card__text">{text}</p>
    {chips.length > 0 && (
      <ul class="case-card__chips">
        {chips.map((chip) => (
          <li>{chip}</li>
        ))}
      </ul>
    )}
    <a class="case-card__cta" href={href}>
      {cta} <span aria-hidden="true">→</span>
    </a>
  </div>
  {image && (
    <div class="case-card__media">
      <img src={image} alt={imageAlt} loading="lazy" decoding="async" />
    </div>
  )}
</article>

<style>
  .case-card {
    position: relative;
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border: var(--border-edge-thin);
    border-radius: var(--radius-tile);
    background-image: linear-gradient(180deg, var(--color-white-07), var(--color-white-05));
    box-shadow: var(--shadow-edge-md);
    overflow: hidden;
    transition:
      border-color var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard);

    &:hover,
    &:focus-within {
      border-color: var(--color-primary-45);
      box-shadow: var(--shadow-glow-primary);
    }

    &.case-card--featured {
      @media (min-width: 900px) {
        grid-template-columns: 1fr 1.15fr;
        align-items: center;
      }
    }
  }

  .case-card__body {
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }

  .case-card__title {
    margin: 0;
    font-size: var(--text-fluid-h3);
    font-weight: 760;
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: var(--color-white);
  }

  .case-card__text {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .case-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;

    & li {
      padding: 0.3rem 0.8rem;
      border: var(--border-edge-thin);
      border-radius: var(--radius-chip);
      font-size: var(--text-fluid-xs);
      font-weight: 600;
      color: var(--color-text-body);
    }
  }

  .case-card__cta {
    justify-self: start;
    margin-top: 0.5rem;
    padding: 0.7rem 1.4rem;
    border-radius: var(--radius-chip);
    background-color: var(--color-brand-primary);
    font-weight: 700;
    color: var(--color-white);
    box-shadow: var(--shadow-glow-primary);
    transition: background-color var(--duration-fast) var(--ease-standard);

    /* Zone cliquable : toute la carte */
    &::after {
      content: '';
      position: absolute;
      inset: 0;
    }

    &:hover {
      background-color: var(--color-brand-primary-light);
    }
  }

  .case-card__media {
    overflow: hidden;
    border: var(--border-edge-thin);
    border-radius: var(--radius-media);

    & img {
      display: block;
      width: 100%;
      height: auto;
    }
  }
</style>
