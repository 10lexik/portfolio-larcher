---
import { t } from '@core/i18n/t';
import type { Locale } from '@core/content/types';
import type { Proof } from './veepee';

interface Props {
  proofs: Proof[];
  locale?: Locale;
}

const { proofs, locale = 'fr' } = Astro.props;
---

<div class="proofs" role="table" aria-label={t('proofTableCaption', locale)}>
  <div class="proofs__row proofs__row--head" role="row">
    <span role="columnheader">{t('proofColBrand', locale)}</span>
    <span role="columnheader">{t('proofColUrl', locale)}</span>
  </div>
  {proofs.map((proof) => (
    <div class="proofs__row" role="row">
      <span class="proofs__brand" role="cell">
        {proof.brand}
      </span>
      <span role="cell">
        <a href={proof.href} target="_blank" rel="noopener noreferrer">
          {proof.display} ↗
        </a>
        {proof.note && <small>{proof.note}</small>}
      </span>
    </div>
  ))}
</div>

<style>
  .proofs {
    border: var(--border-edge-thin);
    border-radius: var(--radius-tile);
    background-image: linear-gradient(180deg, var(--color-white-07), var(--color-white-05));
    overflow: hidden;
  }

  .proofs__row {
    display: grid;
    gap: 0.25rem 1.5rem;
    padding: 1rem 1.4rem;
    border-bottom: var(--border-edge-thin);

    @media (min-width: 640px) {
      grid-template-columns: 11rem 1fr;
    }

    &:last-child {
      border-bottom: 0;
    }

    & a {
      color: var(--color-brand-mint);
      overflow-wrap: anywhere;

      &:hover {
        text-decoration: underline;
      }
    }

    & small {
      display: block;
      margin-top: 0.15rem;
      color: var(--color-text-subtle);
    }
  }

  .proofs__row--head {
    font-size: var(--text-fluid-label);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .proofs__brand {
    font-weight: 700;
    color: var(--color-brand-amber);
  }
</style>
