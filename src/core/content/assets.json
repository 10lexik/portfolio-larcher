      "checkCommand": "npm run check\n  = astro check\n  && typecheck:svelte && lint && lint:css\n  && lint:tokens && lint:themes && lint:arch\n  && lint:dead && format:check",
      "orchestrator": "// src/core/motion/AnimationOrchestrator.ts\ndocument.addEventListener('astro:before-preparation', (e) => orchestrator.beforePreparation(e));\ndocument.addEventListener('astro:after-preparation', () => orchestrator.afterPreparation());\ndocument.addEventListener('astro:before-swap', () => orchestrator.beginPage());\ndocument.addEventListener('astro:after-swap', () => orchestrator.preparePage());\ndocument.addEventListener('astro:page-load', () => {\n  initStacking();\n  initSectionTimelines();\n  initAllStaggeredGrids();\n  createParallax();\n  playFirstWave();\n});"
