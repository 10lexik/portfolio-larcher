      "scssGlobalTokens": "// src/assets/styles/vars/\n$c-theme: #161616;\n$c-vp: #ec008c;\n$c-text: #464650;\n\nvw($px)   du($px)   vh($px)",
      "vbrand": "<main\n  class=\"app\"\n  v-brand=\"'logos/pierre-vacances.svg'\"\n  v-loader=\"{ type: 'progressBar' }\"\n>",
      "types": "export type HeaderVariant =\n  | 'top'\n  | 'bottom'\n  | 'pop-in'\n  | 'block'\n  | 'center';\n\nexport type HeaderDirection =\n  | 'left' | 'right' | 'up' | 'down'\n  | 'sandwichX' | 'sandwichY' | 'random';\n\nexport type HeaderZoomEffect =\n  | 'zoom-in' | 'zoom-out'\n  | 'zoom-pulse' | 'zoom-rotate' | 'none';",
      "headerAnimation": "<HeaderCus\n  variant=\"pop-in\"\n  :bg=\"{\n    type: 'image',\n    mob: ['header/mob-1.jpg', 'header/mob-2.jpg'],\n    desk: ['header/desk-1.jpg', 'header/desk-2.jpg'],\n    direction: 'sandwichX',\n    zoomEffect: 'zoom-out',\n  }\"\n  :animations=\"{\n    intro: {\n      imageAppear: { duration: 1.1, ease: 'power3.out' },\n      textAppear: {\n        title: { y: 40, duration: 0.8, position: '-=0.4' },\n        cta: { scale: 0.9, duration: 0.5, position: '+=0.15' },\n      },\n    },\n    scroll: {\n      pin: true,\n      pinToElement: '.multi-offer',\n      scaled: 1.15,\n      filtered: 'blur(8px)',\n    },\n  }\"\n/>",
      "timelineManager": "// src/ts/plugins/timelineManager.ts\nreadyTimeline\n  .addLabel('header')\n  .add(headerIntroTl, 'header')\n  .addLabel('headerAnimation>', '>')\n  .add(stickyAppearTl, 'headerAnimation>')\n  .add(scrollAppearTl, 'headerAnimation>')\n  .addLabel('stacking', '>')\n  .addLabel('slider', '>');"
    },
