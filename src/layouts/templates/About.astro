---
import Layout from '@layouts/Layout.astro';
import Section from '@layouts/Section.astro';
import SectionHead from '@blocks/SectionHead/SectionHead.svelte';
import Quote from '@blocks/Quote/Quote.svelte';
import Bento from '@blocks/Bento/Bento.svelte';
import Button from '@ui/Button/Button.svelte';
import Tile from '@ui/Tile/Tile.svelte';
import ExperienceList from '@domains/about/ExperienceList/ExperienceList.svelte';
import { getProfileContent } from '@domains/about/profile';
import { getSite } from '@core/content/site';
import { t } from '@core/i18n/t';
import type { Locale } from '@core/content/types';

interface Props {
  locale?: Locale;
}

const { locale = 'fr' } = Astro.props;
const site = getSite(locale);
const profile = getProfileContent(locale);
---

<Layout title={profile.meta.title} description={profile.meta.description} locale={locale}>
  <Section id="intro" theme="dark" stack class="about-hero" labelledby="about-title">
    <p class="eyebrow" data-reveal>
      {profile.hero.eyebrow}
    </p>
    <h1 id="about-title" class="about-hero__title" data-split-title>
      {site.name}, <em>{profile.hero.titleRole}</em> {profile.hero.titleSuffix}
    </h1>
    <p class="lead" data-reveal>
      {profile.hero.lead}
    </p>
    <div class="cluster" data-reveal>
      <Button
        href={site.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        label={t('contactLinkedIn', locale)}
        variant="primary"
        size="lg"
      />
      <Button
        href={site.codepen}
        target="_blank"
        rel="noopener noreferrer"
        label={profile.hero.codepenLabel}
        variant="outline"
        size="lg"
      />
    </div>
  </Section>

  <Section id="savoir-faire" theme="raised" labelledby="skills-title">
    <SectionHead
      id="skills-title"
      eyebrow={profile.sections.skills.eyebrow}
      title={profile.sections.skills.title}
    />
    <Bento
      items={profile.skills.map((s) => ({ title: s.title, text: s.text, accent: s.accent }))}
    />
  </Section>

  <Section id="experience" theme="dark" size="medium" labelledby="xp-title">
    <SectionHead
      id="xp-title"
      eyebrow={profile.sections.experience.eyebrow}
      title={profile.sections.experience.title}
    />
    <ExperienceList locale={locale} />
  </Section>

  <Section id="formation" theme="raised" labelledby="edu-title">
    <SectionHead
      id="edu-title"
      eyebrow={profile.sections.education.eyebrow}
      title={profile.sections.education.title}
    />
    <div
      class="grid-auto"
      style="

--grid-min: 15rem"
    >
      {profile.education.map((item, i) => (
        <div data-reveal style={`--reveal-index:${i}`}>
          <Tile label={item.period} title={item.title} class="about-fill">
            <p>{item.text}</p>
          </Tile>
        </div>
      ))}
    </div>
    <div class="about-quote">
      <Quote text={profile.philosophy.text} cite={profile.philosophy.cite} />
    </div>
  </Section>
</Layout>

<style is:global>
  .about-hero {
    padding-top: clamp(2rem, 4.5vw, 3.5rem);
  }

  .about-hero .container {
    display: grid;
    gap: 1.25rem;
  }

  .about-hero__title {
    margin: 0;
    max-width: 26ch;
    font-size: var(--text-fluid-h1);
    font-weight: 780;
    line-height: 1.08;
    letter-spacing: -0.028em;
    color: var(--color-white);

    & em {
      font-style: normal;
      background-image: linear-gradient(
        90deg,
        var(--color-brand-primary-light),
        var(--color-brand-violet)
      );
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
  }

  .about-fill {
    height: 100%;
  }

  .about-quote {
    margin-top: clamp(2rem, 5vw, 4rem);
    max-width: 48rem;
  }
</style>
